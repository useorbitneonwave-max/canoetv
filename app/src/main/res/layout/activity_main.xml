<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- Side menu (TV / landscape) or bottom bar (phones in portrait) -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:background="#101217"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/navBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingBottom="18dp"
            android:text="CanoeTV"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/navHome" style="@style/NavItem" android:text="🏠   Home" />
        <TextView android:id="@+id/navSearch" style="@style/NavItem" android:text="🔍   Search" />
        <TextView android:id="@+id/navLive" style="@style/NavItem" android:text="📺   Live TV" />
        <TextView android:id="@+id/navMovies" style="@style/NavItem" android:text="🎬   Movies" />
        <TextView android:id="@+id/navGuide" style="@style/NavItem" android:text="🗓   TV Guide" />
        <TextView android:id="@+id/navSettings" style="@style/NavItem" android:text="⚙   Settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- HOME -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="Loading channels…"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- SEARCH -->
        <LinearLayout
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/settings_row_bg"
                android:hint="🔍  Search channels, shows and movies"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/muted"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/searchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingTop="10dp"
                android:paddingEnd="28dp"
                android:text="Type at least 2 letters. Search looks through channel names, categories, what's on in the TV guide, and free movies."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>

        <!-- MOVIES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/moviesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <!-- TV GUIDE: live preview + show details on top, guide grid below -->
        <LinearLayout
            android:id="@+id/guideView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/guideTop"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.42"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:id="@+id/guidePreviewBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.44"
                    android:background="#000000">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/guidePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        app:show_buffering="when_playing"
                        app:use_controller="false" />

                    <TextView
                        android:id="@+id/guidePreviewMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Move through the guide to preview a channel"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/guideLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        android:background="#CCE50914"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="LIVE"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.56"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/guideInfoChannel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:singleLine="true"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/guideInfoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="TV Guide"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/guideInfoTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <ProgressBar
                            android:id="@+id/guideInfoProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="12dp"
                            android:max="100"
                            android:progressTint="@color/accent"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/guideInfoDesc"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="5"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/guideInfoHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="OK: watch full screen   ·   ← → shows   ·   ↑ ↓ channels"
                        android:textColor="#808A91A3"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="6dp">

                    <TextView android:id="@+id/guideListBtn" style="@style/Chip" android:textStyle="bold" android:text="📺 Channel list ▾" />
                    <TextView android:id="@+id/chipGuide" style="@style/Chip" android:text="With guide" />
                    <TextView android:id="@+id/chipFav" style="@style/Chip" android:text="★ Favourites" />
                    <TextView android:id="@+id/chipAll" style="@style/Chip" android:text="All channels" />

                    <LinearLayout
                        android:id="@+id/guideGroupChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView android:id="@+id/guideEarlier" style="@style/Chip" android:text="◀ Earlier" />
                    <TextView android:id="@+id/guideNow" style="@style/Chip" android:text="Now" />
                    <TextView android:id="@+id/guideLater" style="@style/Chip" android:text="Later ▶" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/guideDay"
                    android:layout_width="128dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.canoebay.canoetv.TimeRulerView
                    android:id="@+id/guideRuler"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/guideEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/guideList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.58" />
        </LinearLayout>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/settingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp" />
        </ScrollView>

        <!-- LIVE TV -->
        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/bg"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/playerBox"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:show_buffering="never" />

                <ProgressBar
                    android:id="@+id/loading"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Loading channels…"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <!-- Channel banner shown when switching channels or typing a number -->
                <LinearLayout
                    android:id="@+id/banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:background="#D90B0D12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/bannerLogo"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bannerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="420dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bannerSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="@color/accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/listPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nowPlaying"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:paddingStart="4dp"
                        android:singleLine="true"
                        android:text="CanoeTV"
                        android:textColor="@color/accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lastBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/row_bg"
                        android:clickable="true"
                        android:contentDescription="Last channel"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="⇄"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/menuBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/row_bg"
                        android:clickable="true"
                        android:contentDescription="Menu"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="⋮"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/sourceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sourceBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/settings_row_bg"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/groupSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search channels"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="4dp"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
